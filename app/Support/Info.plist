<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>brosis</string>
	<key>CFBundleDisplayName</key>
	<string>brosis</string>
	<key>CFBundleIdentifier</key>
	<string>com.brosis.app</string>
	<key>CFBundleExecutable</key>
	<string>brosis</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- 应用图标：Resources/AppIcon.icns，由 Support/icon/make_icon.swift 生成 -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- 版本号的唯一来源是 Sources/brosis/BuildInfo.swift 的 `version`：
	     build_app.sh 组装 bundle 时把下面两个占位符替换成它，
	     自检再从 Bundle.main 读回来和 BuildInfo.version 比一次（app/README 4、6.1）。
	     直接手改这里没有意义——组装时会被覆盖。 -->
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- 菜单栏常驻，不出现在 Dock 与 Cmd-Tab -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>brosis · 个人活动记忆，仅本机使用</string>
	<!-- TCC usage string：缺失会导致静默失败（报告 3.3） -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>brosis 需要屏幕录制权限，用于按 1 秒间隔读取当前屏幕的变化区域并读取窗口标题，从而记录你看过什么。画面不会被保存，只保留文字与统计。</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>brosis 需要辅助功能权限，用于读取当前焦点窗口的标题、文件路径、网址和可见正文，作为文字记录的主要来源，避免频繁截图。</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>brosis 需要向浏览器发送 Apple 事件，用于在辅助功能读不到网址时获取当前标签页的地址与标题。不会控制这些应用做其他操作。</string>
	<!-- ============================ Sparkle 2 签名更新（计划 4.2） ============================
	     口径见 Sources/brosis/Updater.swift 顶部：默认不联网、fail-closed、懒启动。 -->
	<!-- appcast 的地址。GitHub Release 的 latest/download/<资产名> 是一个稳定跳转，
	     每次发版把 appcast.xml 作为资产传到新 tag 上就行，不用改 app。 -->
	<key>SUFeedURL</key>
	<string>https://github.com/AllenBall/brosis/releases/latest/download/appcast.xml</string>
	<!-- Ed25519 公钥（base64，32 字节）。**仓库里是占位符**：真公钥由用户用 Sparkle 的
	     generate_keys 生成（私钥留在他自己的钥匙串，永不进仓库），公钥放在
	     ~/Library/Application Support/brosis-dev/sparkle_public_ed_key.txt，
	     build_app.sh 组装 bundle 时替换这里。没替换时 Sparkle 拒绝启动（fail-closed）。 -->
	<key>SUPublicEDKey</key>
	<string>__SUPublicEDKey__</string>
	<!-- 默认不自动检查更新：不联网、也不弹"要不要自动检查更新"的许可框。
	     更新检查只能由用户从菜单「检查更新…」显式发起。 -->
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<!-- 即使将来把上面那条打开，也不允许后台静默下载 / 安装。 -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<!-- 只有 SUEnableAutomaticChecks 被显式打开时才有意义：24 小时一次。 -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- 不给 Sparkle 的更新说明页放开 JavaScript。 -->
	<key>SUEnableJavaScriptInReleaseNotes</key>
	<false/>
</dict>
</plist>
